ANTHROPIC_API_KEY=sk-ant-your-key-here
JWT_SECRET=change-me-to-a-long-random-string
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client.
# Same value is used by the frontend (to render the button) and the api-service
# (to verify the ID token's audience).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
POSTGRES_USER=snap2spoon
POSTGRES_PASSWORD=snap2spoon
POSTGRES_DB=snap2spoon
DATABASE_URL=postgresql+psycopg://snap2spoon:snap2spoon@postgres:5432/snap2spoon
ANALYZER_URL=http://analyzer:8001
# The frontend proxies /api/* to the api service; no public API URL to set.
# OTel is disabled by default — set endpoint + exporter if you run a collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
