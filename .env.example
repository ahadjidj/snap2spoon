ANTHROPIC_API_KEY=sk-ant-your-key-here
JWT_SECRET=change-me-to-a-long-random-string
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client.
# Same value is used by the frontend (to render the button) and the api-service
# (to verify the ID token's audience).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
POSTGRES_USER=snap2spoon
POSTGRES_PASSWORD=snap2spoon
POSTGRES_DB=snap2spoon
DATABASE_URL=postgresql+psycopg://snap2spoon:snap2spoon@postgres:5432/snap2spoon
ANALYZER_URL=http://analyzer:8001

# ── Backend OTel (api-service, analyzer-service, frontend SSR) ───────────────
# Disabled by default. To enable, set OTEL_TRACES_EXPORTER=otlp and point the
# endpoint at your Alloy / OTel Collector receiver (OTLP HTTP, port 4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# ── Frontend browser observability (Grafana Faro) ────────────────────────────
# Disabled by default. To enable, set NEXT_PUBLIC_FARO_URL to the Grafana Cloud
# Faro collector endpoint and rebuild the frontend image (NEXT_PUBLIC_* vars are
# baked into the JS bundle at build time).
# Find the URL in Grafana Cloud -> Frontend Observability -> your app -> Setup.
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_FARO_APP_NAME=snap2spoon
